# Copiar como ".env" en el root del proyecto. Este es el único archivo de
# entorno operativo: el hub y todos los agentes leen desde aquí.

OPENAI_API_KEY=sk-
ANTHROPIC_API_KEY=sk-ant
GOOGLE_API_KEY=

HOST=127.0.0.1
PORT=8010
SEND_REQUEST_DEFAULT_TARGET=render
NGROK_BASE_URL=
RENDER_BASE_URL=https://ghl-agent-tools.onrender.com

NGROK_TOKEN=
NGROK_DOMAIN=

# Family Aims
FA_GOOGLE_CLIENT_ID_IVF=
FA_GOOGLE_CLIENT_SECRET_IVF=
FA_GOOGLE_REFRESH_TOKEN_IVF=
FA_CALENDAR_ID_IVF=achuquisan@familyaims.com
FA_DURATION_MINUTES_IVF=20
FA_GAP_MINUTES_IVF=10
FA_DAYS_AHEAD_IVF=7

FA_GOOGLE_CLIENT_ID_SUR=
FA_GOOGLE_CLIENT_SECRET_SUR=
FA_GOOGLE_REFRESH_TOKEN_SUR=
FA_CALENDAR_ID_SUR=marango@familyaims.com
FA_DURATION_MINUTES_SUR=20
FA_GAP_MINUTES_SUR=10
FA_DAYS_AHEAD_SUR=7

FA_GOOGLE_CLIENT_ID_GMAIL=
FA_GOOGLE_CLIENT_SECRET_GMAIL=
FA_GOOGLE_REFRESH_TOKEN_GMAIL=
FA_GMAIL_SENDER_EMAIL=

# Novafem Surrogacy
NFS_GOOGLE_CLIENT_ID=
NFS_GOOGLE_CLIENT_SECRET=
NFS_GOOGLE_REFRESH_TOKEN=
NFS_CALENDAR_ID=primary
NFS_DURATION_MINUTES=30
NFS_GAP_MINUTES=5
NFS_DAYS_AHEAD=14
NFS_GOOGLE_CLIENT_ID_GMAIL=
NFS_GOOGLE_CLIENT_SECRET_GMAIL=
NFS_GOOGLE_REFRESH_TOKEN_GMAIL=
NFS_GMAIL_SENDER_EMAIL=
NFS_CONTACT_CENTER_EMAIL=

# Utils
GHL_TOKEN=
GHL_VERSION=v3

# Sam agent tuning (opcional; sin definir usa el default de agent.json)
# Prende/apaga el auditor que fuerza tools "critical" cuando el LLM responde sin llamarlas.
SAM_AUDIT_TOOL_USAGE=true

# Dias de memoria compartidos por TODOS los agentes de texto/GHL (no uno por
# agente, a diferencia de debounce/lookback mas abajo): cuanto tiempo sin
# actividad antes de que el proximo mensaje arranque una conversacion nueva
# en vez de continuar la existente. Antes esto estaba fijo por agente en su
# manifest.yaml compilado (session_timeout_minutes) -- requeria recompilar
# para cambiarlo; ahora esta variable es la que realmente manda para el
# pipeline de GHL.
GHL_TEXT_HISTORY_MAX_DAYS=7

# sam_text (pipeline compilado): ventana de debounce, en segundos desde el
# ultimo mensaje entrante, antes de correr el grafo. Junta rafagas de
# WhatsApp en un solo turno.
SAM_TEXT_DEBOUNCE_SECONDS=15
# Whitelist de pilotaje (numeros separados por coma, formato E.164). Solo se
# procesan mensajes de estos numeros mientras SAM_TEXT_ENFORCE_PHONE_WHITELIST
# sea true (default). Ponela en false para abrir el agente a cualquier
# numero, sin tocar codigo, cuando este listo para produccion real.
SAM_TEXT_ALLOWED_PHONES=+573215616921,+573007011593,+573016804227,+573103725324
SAM_TEXT_ENFORCE_PHONE_WHITELIST=true

# babynova_triage_obstetrico_text (pipeline compilado): mismo patron de
# debounce que sam_text. Nota: los tools contacto_ap y citas_prioritarias
# de este flujo todavia no estan implementados (ver TODO.md) -- el endpoint
# esta wireado igual para dejar la parte de mensajeria/sesion probada.
BABYNOVA_TRIAGE_DEBOUNCE_SECONDS=15
# Mismo patron de whitelist que sam_text. IMPORTANTE: no pongas esta en
# false hasta que contacto_ap/citas_prioritarias esten implementadas (ver
# TODO.md) -- es lo unico que hoy evita que trafico real de WhatsApp le
# llegue a esos dos nodos rotos.
BABYNOVA_TRIAGE_ALLOWED_PHONES=+573215616921,+573007011593,+573016804227,+573103725324
BABYNOVA_TRIAGE_ENFORCE_PHONE_WHITELIST=true

# Pipeline compilado: si DATABASE_HOST (o DATABASE_URL) esta seteada, el
# checkpointer de LangGraph usa Postgres (persiste un redeploy) en vez de un
# archivo SQLite local por agente. Ninguna de las dos seteada = sigue
# usando SQLite, sin cambios.
#
# Dos formas de configurarlo:
#   (a) DATABASE_URL, un solo connection string completo -- lo que usa hoy
#       el dashboard de Render para la app desplegada (host interno).
#   (b) Las piezas sueltas de abajo -- lo que usa este .env local (host
#       externo, la unica forma de conectarse desde afuera de la red de
#       Render). DATABASE_HOST tiene prioridad si esta seteado.
DATABASE_URL=
DATABASE_HOST=
# DATABASE_REGION vacio = host interno (sin sufijo). Seteado = host externo
# -- se le agrega como ".{DATABASE_REGION}" al host automaticamente (no le
# pongas el punto inicial). Ejemplo real: oregon-postgres.render.com
DATABASE_REGION=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
# Tamano maximo del pool de conexiones compartido (checkpointer + tabla
# conversations). Solo aplica si Postgres esta habilitado.
DATABASE_POOL_MAX_SIZE=5

# Mensaje de cierre por inactividad (solo agentes de texto/GHL, requiere
# Postgres -- necesita sobrevivir un redeploy, un timer en memoria no):
# WhatsApp corta el envio libre de mensajes 24h despues del ultimo mensaje
# del contacto. Un sweep periodico manda un mensaje generico a los 23:45
# (antes del corte) a cualquier hilo inactivo que todavia no lo haya
# recibido en esta ventana. Cada cuanto corre el sweep, global:
CLOSING_MESSAGE_SWEEP_INTERVAL_SECONDS=300
# Cuantos dias hacia atras sigue considerando el sweep -- NO es el disparador
# (siempre ~23:45 de inactividad), es un limite de seguridad para que un
# sweep que estuvo caido no le escriba de golpe a conversaciones viejas al
# volver. Una variable por agente:
SAM_TEXT_CLOSING_SWEEP_LOOKBACK_DAYS=3
BABYNOVA_TRIAGE_CLOSING_SWEEP_LOOKBACK_DAYS=3
