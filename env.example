# Copiar como ".env" en el root del proyecto. Este es el único archivo de
# entorno operativo: el hub y todos los agentes leen desde aquí.

# =============================================================================
# 1. MODELOS DE IA
# =============================================================================
# Claves de los proveedores.
OPENAI_API_KEY=sk-
ANTHROPIC_API_KEY=sk-ant
GOOGLE_API_KEY=
# Modelo de OpenAI que usan los agentes compilados (router, extraccion de datos
# y redaccion de mensajes). Vacio = gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# 2. ROUTER GLOBAL
# =============================================================================
# true = filtro de respeto (ante odio, vulgaridades o trato despectivo responde
# un recordatorio cortes y repite la pregunta pendiente); false = sin filtro.
GLOBAL_ROUTER_RESPECT_FILTER=true
# true = el modelo detecta los cambios de idioma; false = frases fijas primero,
# sin llamar al modelo.
GLOBAL_ROUTER_LANGUAGE_DETECTION=false

# =============================================================================
# 3. SERVIDOR Y TUNELES
# =============================================================================
HOST=127.0.0.1
PORT=8010
# Hacia donde apunta send_request por defecto (render o ngrok).
SEND_REQUEST_DEFAULT_TARGET=render
RENDER_BASE_URL=
NGROK_BASE_URL=
NGROK_TOKEN=
NGROK_DOMAIN=
# true/1 = cierra el tunel ngrok que ya este abierto antes de abrir uno nuevo.
NGROK_KILL_EXISTING=

# =============================================================================
# 4. BASE DE DATOS (POSTGRES)
# =============================================================================
# Postgres (checkpointer + conversations table). Two ways to configure it;
# neither set = falls back to local SQLite per agent, no Postgres:
#   (a) DATABASE_URL -- one full connection string. Only used as a fallback,
#       when DATABASE_HOST below is empty.
#   (b) DATABASE_HOST + the pieces below -- takes priority whenever
#       DATABASE_HOST is set (DATABASE_URL is then ignored, even if it has
#       a value). Avoids repeating the password across two full strings
#       (Render's internal vs external connection, which only differ by
#       whether DATABASE_REGION gets appended to the host).
# Local .env files should use (b), with the external host -- a machine
# outside Render's own network can't resolve the internal one.
DATABASE_URL=
DATABASE_HOST=
# Empty = internal host as-is (no region suffix -- what Render's own
# dashboard uses for the deployed app). Set = external (appended as
# ".{DATABASE_REGION}" automatically -- do not include the leading dot).
DATABASE_REGION=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
# Max size of the shared connection pool (checkpointer + conversations
# table). Only applies once Postgres is enabled.
DATABASE_POOL_MAX_SIZE=5

# =============================================================================
# 5. GOHIGHLEVEL (GHL)
# =============================================================================
GHL_VERSION=v3
# GHL_TOKEN_2 no lo lee el codigo actual.
GHL_TOKEN_2=
# Family Aims.
FA_GHL_TOKEN=
FA_GHL_LOCATION_ID=
# BabyNova.
BN_GHL_TOKEN=
BN_GHL_LOCATION_ID=

# =============================================================================
# 6. FAMILY AIMS: CALENDARIOS Y CORREO
# =============================================================================
# --- Calendario IVF ---
FA_GOOGLE_CLIENT_ID_IVF=
FA_GOOGLE_CLIENT_SECRET_IVF=
FA_GOOGLE_REFRESH_TOKEN_IVF=
FA_CALENDAR_ID_IVF=
FA_GHL_CALENDAR_ID_IVF=
FA_DURATION_MINUTES_IVF=20
FA_GAP_MINUTES_IVF=10
FA_DAYS_AHEAD_IVF=7

# --- Calendario SUR (subrogacion) ---
FA_GOOGLE_CLIENT_ID_SUR=
FA_GOOGLE_CLIENT_SECRET_SUR=
FA_GOOGLE_REFRESH_TOKEN_SUR=
FA_CALENDAR_ID_SUR=
FA_GHL_CALENDAR_ID_SUR=
FA_DURATION_MINUTES_SUR=20
FA_GAP_MINUTES_SUR=10
FA_DAYS_AHEAD_SUR=7

# --- Gmail (envio de correos) ---
FA_GOOGLE_CLIENT_ID_GMAIL=
FA_GOOGLE_CLIENT_SECRET_GMAIL=
FA_GOOGLE_REFRESH_TOKEN_GMAIL=
FA_GMAIL_SENDER_EMAIL=

# =============================================================================
# 7. NOVAFEM SURROGACY: CALENDARIO Y CORREO
# =============================================================================
NFS_GOOGLE_CLIENT_ID=
NFS_GOOGLE_CLIENT_SECRET=
NFS_GOOGLE_REFRESH_TOKEN=
NFS_CALENDAR_ID=primary
NFS_DURATION_MINUTES=30
NFS_GAP_MINUTES=5
NFS_DAYS_AHEAD=14
NFS_GOOGLE_CLIENT_ID_GMAIL=
NFS_GOOGLE_CLIENT_SECRET_GMAIL=
NFS_GOOGLE_REFRESH_TOKEN_GMAIL=
NFS_GMAIL_SENDER_EMAIL=
NFS_CONTACT_CENTER_EMAIL=

# =============================================================================
# 8. MENSAJERIA GHL: MEMORIA Y DEBUG
# =============================================================================
# Dias de memoria compartidos por TODOS los agentes de texto/GHL (no uno por
# agente, a diferencia de debounce/lookback mas abajo): cuanto tiempo sin
# actividad antes de que el proximo mensaje arranque una conversacion nueva
# en vez de continuar la existente. Antes esto estaba fijo por agente en su
# manifest.yaml compilado (session_timeout_minutes) -- requeria recompilar
# para cambiarlo; ahora esta variable es la que realmente manda para el
# pipeline de GHL.
GHL_TEXT_HISTORY_MAX_DAYS=7
# Whitelist de telefonos para /tools/v1/echo (herramienta de debug para probar
# el envio de mensajes por GHL). Vacio = nadie pasa el filtro.
ECHO_ALLOWED_PHONES=

# =============================================================================
# 9. AGENTES DE TEXTO: DEBOUNCE Y WHITELIST
# =============================================================================
# --- sam_text (pipeline compilado) ---
# Ventana de debounce, en segundos desde el ultimo mensaje entrante, antes de
# correr el grafo. Junta rafagas de WhatsApp en un solo turno.
SAM_TEXT_DEBOUNCE_SECONDS=15
# Whitelist de pilotaje (numeros separados por coma, formato E.164). Solo se
# procesan mensajes de estos numeros mientras SAM_TEXT_ENFORCE_PHONE_WHITELIST
# sea true (default). Ponela en false para abrir el agente a cualquier
# numero, sin tocar codigo, cuando este listo para produccion real.
SAM_TEXT_ALLOWED_PHONES=
SAM_TEXT_ENFORCE_PHONE_WHITELIST=true

# --- babynova_triage_obstetrico_text (pipeline compilado) ---
# Mismo patron de debounce que sam_text. Nota: los tools contacto_ap y
# citas_prioritarias de este flujo todavia no estan implementados (ver
# TODO.md) -- el endpoint esta wireado igual para dejar la parte de
# mensajeria/sesion probada.
BABYNOVA_TRIAGE_DEBOUNCE_SECONDS=15
# Mismo patron de whitelist que sam_text. IMPORTANTE: no pongas esta en
# false hasta que contacto_ap/citas_prioritarias esten implementadas (ver
# TODO.md) -- es lo unico que hoy evita que trafico real de WhatsApp le
# llegue a esos dos nodos rotos.
BABYNOVA_TRIAGE_ALLOWED_PHONES=
BABYNOVA_TRIAGE_ENFORCE_PHONE_WHITELIST=true

# --- babynova_surrogate_questions_text (pipeline compilado) ---
# Mismo patron que sam_text, con un debounce mas corto (7s).
BABYNOVA_SURROGATE_QUESTIONS_DEBOUNCE_SECONDS=7
BABYNOVA_SURROGATE_QUESTIONS_ALLOWED_PHONES=
BABYNOVA_SURROGATE_QUESTIONS_ENFORCE_PHONE_WHITELIST=true

# =============================================================================
# 10. MENSAJE DE CIERRE POR INACTIVIDAD
# =============================================================================
# Solo agentes de texto/GHL, requiere Postgres -- necesita sobrevivir un
# redeploy, un timer en memoria no: WhatsApp corta el envio libre de mensajes
# 24h despues del ultimo mensaje del contacto. Un sweep periodico manda un
# mensaje generico a los 23:45 (antes del corte) a cualquier hilo inactivo
# que todavia no lo haya recibido en esta ventana. Cada cuanto corre el
# sweep, global:
CLOSING_MESSAGE_SWEEP_INTERVAL_SECONDS=300
# Cuantos dias hacia atras sigue considerando el sweep -- NO es el disparador
# (siempre ~23:45 de inactividad), es un limite de seguridad para que un
# sweep que estuvo caido no le escriba de golpe a conversaciones viejas al
# volver. Una variable por agente:
SAM_TEXT_CLOSING_SWEEP_LOOKBACK_DAYS=3
BABYNOVA_TRIAGE_CLOSING_SWEEP_LOOKBACK_DAYS=3
BABYNOVA_SURROGATE_QUESTIONS_CLOSING_SWEEP_LOOKBACK_DAYS=3
