# Copiar como ".env" en el root del proyecto. Este es el único archivo de
# entorno operativo: el hub y todos los agentes leen desde aquí.

OPENAI_API_KEY=sk-
ANTHROPIC_API_KEY=sk-ant
GOOGLE_API_KEY=

HOST=127.0.0.1
PORT=8010
SEND_REQUEST_DEFAULT_TARGET=render
NGROK_BASE_URL=
RENDER_BASE_URL=https://ghl-agent-tools.onrender.com

NGROK_TOKEN=
NGROK_DOMAIN=

# Family Aims
FA_GOOGLE_CLIENT_ID_IVF=
FA_GOOGLE_CLIENT_SECRET_IVF=
FA_GOOGLE_REFRESH_TOKEN_IVF=
FA_CALENDAR_ID_IVF=achuquisan@familyaims.com
FA_DURATION_MINUTES_IVF=20
FA_GAP_MINUTES_IVF=10
FA_DAYS_AHEAD_IVF=7

FA_GOOGLE_CLIENT_ID_SUR=
FA_GOOGLE_CLIENT_SECRET_SUR=
FA_GOOGLE_REFRESH_TOKEN_SUR=
FA_CALENDAR_ID_SUR=marango@familyaims.com
FA_DURATION_MINUTES_SUR=20
FA_GAP_MINUTES_SUR=10
FA_DAYS_AHEAD_SUR=7

FA_GOOGLE_CLIENT_ID_GMAIL=
FA_GOOGLE_CLIENT_SECRET_GMAIL=
FA_GOOGLE_REFRESH_TOKEN_GMAIL=
FA_GMAIL_SENDER_EMAIL=

# Novafem Surrogacy
NFS_GOOGLE_CLIENT_ID=
NFS_GOOGLE_CLIENT_SECRET=
NFS_GOOGLE_REFRESH_TOKEN=
NFS_CALENDAR_ID=primary
NFS_DURATION_MINUTES=30
NFS_GAP_MINUTES=5
NFS_DAYS_AHEAD=14
NFS_GOOGLE_CLIENT_ID_GMAIL=
NFS_GOOGLE_CLIENT_SECRET_GMAIL=
NFS_GOOGLE_REFRESH_TOKEN_GMAIL=
NFS_GMAIL_SENDER_EMAIL=
NFS_CONTACT_CENTER_EMAIL=

# Utils
GHL_TOKEN=
GHL_VERSION=v3

# Sam agent tuning (opcionales; sin definir usan el default de agent.json)
# Ventana de historial que se le manda al LLM, en dias. <=0 = sin limite.
GHL_HISTORY_MAX_DAYS=7
# Prende/apaga el auditor que fuerza tools "critical" cuando el LLM responde sin llamarlas.
SAM_AUDIT_TOOL_USAGE=true
